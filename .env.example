# ===========================================
# ROY CRM - Variáveis de Ambiente
# ===========================================
# IMPORTANTE: Este arquivo serve apenas como
# documentação. NUNCA commite valores reais!
# Copie este arquivo para .env e preencha.
# ===========================================

# -------- SUPABASE (Automático) --------
# Essas variáveis são preenchidas automaticamente
# pelo Lovable Cloud. Não altere manualmente.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# -------- EDGE FUNCTIONS (Secrets) --------
# Configure via Lovable Cloud > Settings > Secrets

# OpenAI - Transcrição de áudio e análise de mensagens
OPENAI_API_KEY=

# Lovable AI Gateway - Recursos de IA internos
LOVABLE_API_KEY=

# WhatsApp Integration (UAZAPI)
UAZAPI_URL=https://your-uazapi-instance.com
UAZAPI_ADMIN_TOKEN=

# Asaas - Gateway de pagamento
ASAAS_API_KEY=

# Resend - Envio de emails
RESEND_API_KEY=

# ZapSign - Assinatura digital
ZAPSIGN_API_TOKEN=

# Omie ERP - Integração contábil
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Pipedrive - CRM externo
PIPEDRIVE_API_TOKEN=

# Stripe - Pagamentos internacionais
STRIPE_SECRET_KEY=

# Zoom - Webhooks de videochamadas
ZOOM_WEBHOOK_SECRET=

# -------- SEGURANÇA AVANÇADA --------
# Chave para criptografia de tokens de terceiros (AES-256, 32 bytes base64)
ENCRYPTION_MASTER_KEY=

# Token para comunicação interna entre Edge Functions
INTERNAL_FUNCTION_TOKEN=
